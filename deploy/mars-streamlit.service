[Unit]
Description=MaRS-py-upgrade Streamlit interface
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=mars
Group=mars
WorkingDirectory=/opt/mars-py-upgrade
ExecStart=/opt/mars-py-upgrade/start.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
